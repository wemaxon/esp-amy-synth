diff --git a/src/amy_prng.h b/src/amy_prng.h
new file mode 100644
--- /dev/null
+++ b/src/amy_prng.h
@@ -0,0 +1,31 @@
+#ifndef AMY_PRNG_H
+#define AMY_PRNG_H
+
+#include <stdint.h>
+
+#define AMY_PRNG_DEFAULT_SEED UINT32_C(517730)
+
+/*
+ * Each oscillator owns one stream.  This keeps dual-core rendering free of
+ * shared read/modify/write state while making reset output reproducible.
+ */
+static inline uint64_t amy_prng_initial_state(uint32_t seed, uint16_t stream)
+{
+    uint64_t mixed = ((uint64_t)seed << 32U) ^ (uint64_t)stream;
+    mixed += UINT64_C(0x9e3779b97f4a7c15);
+    mixed = (mixed ^ (mixed >> 30U)) * UINT64_C(0xbf58476d1ce4e5b9);
+    mixed = (mixed ^ (mixed >> 27U)) * UINT64_C(0x94d049bb133111eb);
+    mixed ^= mixed >> 31U;
+
+    uint64_t state = mixed & UINT64_C(0x0000ffffffffffff);
+    return state != 0U ? state : UINT64_C(0x330e);
+}
+
+static inline int32_t amy_prng_next_i32(uint64_t *state)
+{
+    *state = (UINT64_C(0x5deece66d) * *state + UINT64_C(0xb)) &
+             UINT64_C(0x0000ffffffffffff);
+    return (int32_t)(uint32_t)*state;
+}
+
+#endif
