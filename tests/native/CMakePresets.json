{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Linux native tests (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/native-debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "native-release",
      "inherits": "native-debug",
      "displayName": "Linux native tests (Release)",
      "binaryDir": "${sourceDir}/../../build/native-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "native-debug", "configurePreset": "native-debug", "jobs": 6},
    {"name": "native-release", "configurePreset": "native-release", "jobs": 6}
  ],
  "testPresets": [
    {"name": "native-debug", "configurePreset": "native-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error", "timeout": 30}},
    {"name": "native-release", "configurePreset": "native-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error", "timeout": 30}}
  ]
}
